# SWAP BOI - ENVIRONMENT CONFIGURATION
# Copy this file to .env.local to connect your live Supabase project

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Mapbox or custom tiles (Leaflet OpenStreetMap defaults to free OSRM tiles out-of-the-box)
NEXT_PUBLIC_DEFAULT_CITY=Dhaka
